pipeline {
    agent any

    tools {
        maven "maven-3.9"
    }

    environment {
        SETTINGS = credentials('maven-settings')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                sh "mvn -s $SETTINGS -f app/pom.xml clean install"
            }
        }

        stage('Publish to Nexus') {
            when {
                branch 'main'
            }
            steps {
                sh "mvn -s $SETTINGS -f app/pom.xml deploy"
            }
        }

        stage('Deploy to Test') {
            when {
                branch 'main'
            }
            steps {
                sh """
                    ansible-playbook -i cicd/ansible/inventory cicd/ansible/deploy-test.yml \
                        --extra-vars "artifact=app/target/*.war"
                """
            }
        }

        stage('Approve Prod Deployment') {
            when {
                branch 'main'
            }
            steps {
                input message: "Czy wdrożyć na PROD?"
            }
        }

        stage('Deploy to Prod') {
            when {
                branch 'main'
            }
            steps {
                sh """
                    ansible-playbook -i cicd/ansible/inventory cicd/ansible/deploy-prod.yml \
                        --extra-vars "artifact=app/target/*.war"
                """
            }
        }
    }
}
